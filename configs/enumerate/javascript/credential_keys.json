{
    "description": "Configuration key names that identify a credential in a JavaScript bundle. A platform key is an opaque string, so the key it is assigned to is the only thing identifying it. Names are matched case-insensitively against the end of the observed key with separators removed, so 'subscriptionKey' matches 'apimSubscriptionKey' and 'apim_subscription_key'. placeholderValues must equal the whole value; placeholderMarkers need only appear within it, so only put unambiguous words there.",
    "credentialKeyNames": [
        "accessKey",
        "accessToken",
        "apiKey",
        "apiSecret",
        "authToken",
        "bearerToken",
        "clientSecret",
        "clientToken",
        "connectionString",
        "encryptionKey",
        "passphrase",
        "password",
        "passwd",
        "privateKey",
        "refreshToken",
        "sasToken",
        "secret",
        "secretKey",
        "sessionToken",
        "sharedKey",
        "signingKey",
        "subscriptionKey"
    ],
    "publicKeyNames": [
        "appId",
        "clientId",
        "instrumentationKey",
        "measurementId",
        "projectId",
        "publicKey",
        "trackingId"
    ],
    "placeholderValues": [
        "changeme",
        "empty",
        "example",
        "false",
        "none",
        "null",
        "placeholder",
        "redacted",
        "true",
        "undefined"
    ],
    "minimumValueLength": 12,
    "placeholderMarkers": [
        "changeme",
