#!/usr/bin/env bash
# Non-blocking warning for test artifacts (public IPs) in staged changes.
# Enable once per clone:  git config core.hooksPath .githooks
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
script="$root/scripts/check-test-artifacts.py"

[ -f "$script" ] || exit 0
command -v python3 >/dev/null 2>&1 || exit 0

python3 "$script" --staged || true
exit 0
